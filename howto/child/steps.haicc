# step: the host, from the boot mrepo: built from the haicc component, its runtime started
. boot/deploy host haiccing/base-component-haicc
# expect: "deployed":"host"
# step: a node, from the host: its package fully qualified, <org>/<package>
host boot/deploy node-1 haiccing/base-package-runtime
# expect: "deployed":"node-1","mrepo":"local/node-1"
# step: read through the host: the request hops at its shortcut
host/node-1 crud/read .
# expect: error: no protocol: crud
# step: redeployed from the package it came from (or another, named)
host boot/redeploy node-1
# expect: "node-1"
# step: torn down: its runtime stopped, it and its shortcut removed
host boot/teardown node-1
# expect: "node-1"
. boot/teardown host
# expect: "host"
